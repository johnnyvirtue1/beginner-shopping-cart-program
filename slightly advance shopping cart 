total=0
items=[]
products={
  "Chips":20,
  "Dairymilk":60,
  "Coke":40,
  "Oreo":10,
  "Kurkure":25,
}
while True:
  print("\nproduct       price")
  print("_____________________")
  for item,price in products.items():
    print(f"{item:<15}{price}")
  item=input("\nwhat would you like to buy or enter q to quit: ").capitalize()
  if item in products:
    price=products[item]
  elif item=="Q":
    break
  else:
    print("\nInvalid item!")
    continue
  quantity=(input("\nHow many items do you like to buy: "))
  while not quantity.isdigit():
    print("\nQuantity should be in Digits!!")
    quantity=(input("\nHow many items do you like to buy: "))
  total_cost=int(quantity)*price
  total+=total_cost
  items.append(f"{quantity} {item}")
  print(f"\n{quantity} {item}(s) have been added to ur cart 🛒")
  print(f"\nYour total cost is ₹{total}✨")
  print(f"your total items are {items}",end=" ")
  another_item=input("\nDo you like to buy something else?(y/or q to quit): ").lower()
  if another_item=="q":
    break
print("\n-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-")
if total<=100:
  print("\n   thank you for shopping 🤡")
else:
  print("\n  thank you for shopping 🤤🤤")
